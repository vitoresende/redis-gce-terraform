# Local .terraform directories
**/.terraform/*

# .tfstate files contain sensitive state data
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files as they may contain secrets/passwords
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore execution plans
*.tfplan

# OS and Editor temporary files
.DS_Store
.vscode/
.idea/
*.swp
